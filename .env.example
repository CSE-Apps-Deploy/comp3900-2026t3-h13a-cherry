FRONTEND_URL=https://localhost:8443
CORS_ORIGIN=http://localhost:3000,https://localhost:8443
EMAIL_VERIFICATION_REQUIRED=true
# Local development defaults. The startup script will create `.env` from this
# file on first run if it does not already exist.
JWT_SECRET=local-dev-jwt-secret-change-me
JWT_REFRESH_SECRET=local-dev-jwt-refresh-secret-change-me
# Team test deployments default to Fake Payment; no Stripe keys are needed.
APP_ENV=local
PAYMENT_PROVIDER=fake
# To test Stripe instead, set PAYMENT_PROVIDER=stripe in your local .env.
# Default email delivery: local Mailpit through Docker Compose.
EMAIL_FROM=TutorConnect <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional Brevo SMTP: replace the email settings above in your local .env.
# Obtain the Brevo SMTP login and your assigned SMTP key privately from the
# account owner. Fill them in locally; never commit credentials or your .env.
# EMAIL_FROM="TutorConnect <yuchongdeng42@gmail.com>"
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# See README.md for setup and real-mail testing steps.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=https://localhost:8443
# Optional for local payment testing. Leave blank unless you are testing Stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_PLATFORM_FEE_PERCENT=15
# Country for tutor connected payout accounts. Cannot change once an account
# exists, so treat this as fixed per deployment. Defaults to AU when blank.
STRIPE_CONNECT_COUNTRY=AU
POSTGRES_HOST_PORT=15432
BACKEND_HOST_PORT=5050
FRONTEND_HOST_PORT=3000
NGINX_HOST_PORT=8443
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
